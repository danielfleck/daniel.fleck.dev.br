#!/bin/sh
set -u

if [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"
elif [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"
else
  PY="python3"
fi

"$PY" scripts/rebuild.py --hook
status=$?
if [ "$status" -eq 3 ]; then
  echo "Commit interrompido: rebuild alterou arquivos. Revise, execute git add -A e repita."
  exit 1
fi
if [ "$status" -ne 0 ]; then
  exit "$status"
fi

"$PY" scripts/build_docs.py --hook
status=$?
if [ "$status" -eq 3 ]; then
  echo "Commit interrompido: build_docs alterou arquivos. Revise, execute git add -A e repita."
  exit 1
fi
if [ "$status" -ne 0 ]; then
  exit "$status"
fi

"$PY" scripts/compliance_gate.py --staged --enforce || exit 1
"$PY" scripts/validate.py || exit 1
"$PY" scripts/validate_docs.py || exit 1
"$PY" scripts/validate_contact_surface.py || exit 1
"$PY" scripts/validate_legal_rationale.py || exit 1

exit 0

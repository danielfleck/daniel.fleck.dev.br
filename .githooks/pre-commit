#!/bin/sh
set -u
if [ -x ".venv/bin/python" ]; then PY=".venv/bin/python"; elif [ -x ".venv/Scripts/python.exe" ]; then PY=".venv/Scripts/python.exe"; else PY="python3"; fi
"$PY" scripts/rebuild.py --hook
status=$?
if [ "$status" -eq 3 ]; then
  echo "Commit interrompido: o rebuild alterou arquivos gerados. Revise e execute git add -A; depois repita o commit."
  exit 1
fi
if [ "$status" -ne 0 ]; then exit "$status"; fi
"$PY" scripts/validate.py || exit 1
exit 0

#!/bin/sh
set -u

if [ -x ".venv/bin/python" ]; then
  PY=".venv/bin/python"
elif [ -x ".venv/Scripts/python.exe" ]; then
  PY=".venv/Scripts/python.exe"
else
  PY="python3"
fi

echo "Pre-push: auditando requisições de rede do site gerado..."
"$PY" scripts/audit_network.py --all || {
  echo "Push interrompido: a auditoria headless detectou erro ou host externo não autorizado."
  echo "Consulte dist/network-audit.json."
  exit 1
}

exit 0

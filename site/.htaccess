# CONFIGURAÇÃO FINAL — Apache sem Varnish.
RewriteEngine On

RewriteCond %{HTTPS} =on
RewriteRule ^ - [E=IS_HTTPS:1]

RewriteCond %{SERVER_PORT} =80
RewriteRule ^(.*)$ https://daniel.fleck.dev.br/$1 [R=301,L]

# Cabeçalhos comuns do site estático.
# Confirmar após o deploy com curl e scripts/validate_transport_security.py.
#
# A CSP completa do site principal permanece também em <meta>.
# frame-ancestors precisa ser entregue como cabeçalho HTTP.

Header always set Content-Security-Policy "frame-ancestors 'none'"
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "no-referrer"
Header always set X-Content-Type-Options "nosniff"
Header always set X-DNS-Prefetch-Control "off"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

Header always set Strict-Transport-Security "max-age=31536000" env=IS_HTTPS
